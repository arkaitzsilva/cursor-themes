# Maintainer: Arkaitz Silva <arkaitz.develop@gmail.com>

pkgname=cursor-theme-nx
pkgver=1.0
pkgrel=1
pkgdesc="Nx Cursor Theme"
arch=('any')
url="https://github.com/arkaitzsilva/cursor-themes"
license=('GPL3')
groups=(cursor-themes)
options=(!strip !emptydirs)

prepare() {
	cp -af ../files/. "$srcdir"
}

package() {
	local _icondir="$pkgdir"/usr/share/icons
	mkdir -p "$_icondir"
	cp -r "$srcdir"/* "$_icondir"
}
